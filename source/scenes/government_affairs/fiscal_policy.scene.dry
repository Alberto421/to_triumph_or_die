title: Fiscal Policy
new-page: true
is-card: true
tags: govt_affairs, cabinet
on-arrival: fiscal_policy_timer += 6; month_actions += 1
view-if: psoe_in_government = 1 and finance_minister_party = "PSOE" and fiscal_policy_timer = 0
card-image: img/portraits/prieto.jpg
