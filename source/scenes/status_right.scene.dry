    [? if chancellor = "Prieto" :<img src="img/portraits/prieto.jpg" style="width: 100%;"> ?]
    [? if chancellor = "Negrín" :<img src="img/portraits/negrin.png" style="width: 100%;"> ?]
  </div>
</div>

<div style="display: flex; justify-content: space-between; gap: 5px; margin-bottom: 5px;">
  <div style="flex: 1; text-align: center;">
    <p style="font-weight: bold; margin-bottom: 2px;">President of the Republic</p>
    <p style="margin-bottom: 2px;">[+ president +] ([+ president_party +])</p>
  </div>
  <div style="flex: 1; text-align: center;">
    <p style="font-weight: bold; margin-bottom: 2px;">President of the Government</p>
    <p style="margin-bottom: 2px;">[+ chancellor +] ([+ chancellor_party +])</p>
  </div>
</div>

