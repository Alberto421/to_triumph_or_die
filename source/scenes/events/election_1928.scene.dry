    {
        "id": "ap",
        "legend": Q.ap_name,
        "name": Q.ap_name,
        "seats": Math.round(Q.ap_r*4.73),
    },
    {
        "id": "prrs",
        "legend": "PRRS",
        "name": "PRRS",
        "seats": Math.round(Q.prrs_r*4.73),
    },
    {
        "id": "prr",
        "legend": "PRR",
        "name": "PRR",
        "seats": Math.round(Q.prr_r*4.73),
    },
    {
        "id": "other_left_republicans",
        "legend": "Other Left Republicans",
        "name": "Other Left Republicans",
        "seats": Math.round(Q.other_left_republicans_r*4.73),
    },
    {
        "id": "other_right_republicans",
        "legend": "Other Right Republicans",
        "name": "Other Right Republicans",
        "seats": Math.round(Q.other_right_republicans_r*4.73),
    },
    {
        "id": "dlr",
        "legend": "DLR",
        "name": "DLR",
        "seats": Math.round(Q.dlr_r*4.73),
    },
    {
        "id": "other_monarchists",
