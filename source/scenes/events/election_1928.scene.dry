{!<tr><td><div class="box" style='background-color:#00008B'> </div> !} [+ ap_name +]: {!</td><td>!} [+ ap_r +]% {!</td><td>!} [+ str_change_ap +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#000043'> </div> !} Monarchists / Traditionalists: {!</td><td>!} [+ other_monarchists_r +]% {!</td><td>!} [+ str_change_other_monarchists +] {!</td></tr>!}

