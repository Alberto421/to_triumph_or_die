[? if poum_formed : {!<tr><td><div class="box" style='background-color:#A30000'> </div> !}POUM: {!</td><td>!} [+ poum_r +]% {!</td><td>!} [+ str_change_poum +] {!</td></tr>!} ?]

[? if ur_formed : {!<tr><td><div class="box" style='background-color:#9f7c60'> </div> !}UR: {!</td><td>!} [+ ur_r +]% {!</td><td>!} [+ str_change_ur +] {!</td></tr>!} ?]

