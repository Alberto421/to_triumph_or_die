{!<tr><td><div class="box" style='background-color:#C2B280'> </div> !} Other Left Republicans: {!</td><td>!} [+ other_left_republicans_r +]% {!</td><td>!} [+ str_change_other_left_republicans +] {!</td></tr>!}

